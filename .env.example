# ==========================================
# SupportIQ Backend Environment Configuration
# ==========================================
# Copy this file to .env and adjust variables for your local setup.

# Django Core Settings
DJANGO_SECRET_KEY=change-this-in-production-to-a-secure-random-key
DJANGO_DEBUG=True
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1

# PostgreSQL Database Configuration
DB_NAME=supportiq_db
DB_USER=supportiq_user
DB_PASSWORD=your_secure_database_password
DB_HOST=localhost
DB_PORT=5432

# CORS Configuration (React Frontend)
CORS_ALLOWED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
